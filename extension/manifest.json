{
  "manifest_version": 3,
  "name": "Sahibinden AI Asistan (BAI Bilmiş)",
  "version": "1.3",
  "description": "Sahibinden.com ilanlarını yapay zeka ile analiz eder ve Google ile giriş sağlar.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "identity"
  ],
  "oauth2": {
    "client_id": "947861300154-up0g8bbusf6igu778hn1dpp2gahdm1c4.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/userinfo.email",
      "https://www.googleapis.com/auth/userinfo.profile"
    ]
  },
  "host_permissions": [
    "https://*.sahibinden.com/*",
    "https://sahiden.onrender.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.sahibinden.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icon.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}